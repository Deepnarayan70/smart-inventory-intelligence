# Use a local or MongoDB Atlas connection string.
MONGO_URI=mongodb://localhost:27017/inventory_db
# Replace this value with a long random secret before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Keep false until current indexes/data have been reviewed.
AUTO_INIT_DB_INDEXES=false
# Optional; enable only after inspecting existing documents.
MONGO_ENABLE_SCHEMA_VALIDATION=false
